{
  "manifest_version": 2,
  "name": "Line Browser Branding Engine",
  "version": "1.0.0",
  "description": "Rebrands browser UI to Line Browser",
  "content_scripts": [
    {
      "matches": [
        "chrome://*/*",
        "about:*/*",
        "about:*"
      ],
      "js": [
        "brand.js"
      ],
      "run_at": "document_start"
    }
  ]
}
