{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Line Browser",
  "version": "1.0.0",
  "identifier": "com.lineinc.linebrowser",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Line Browser",
        "width": 1280,
        "height": 800,
        "backgroundColor": "#121316",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
