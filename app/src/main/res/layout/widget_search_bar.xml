<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search_bar_root"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:background="@drawable/bg_widget_search"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_search_box"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:paddingEnd="12dp"
        android:text="Search or type web address"
        android:textColor="#9E9E9E"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/btn_widget_voice"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:contentDescription="Voice Search" />

    <ImageView
        android:id="@+id/btn_widget_qr"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_camera"
        android:contentDescription="Scan QR" />

    <ImageView
        android:id="@+id/btn_widget_incognito"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_view"
        android:contentDescription="Incognito" />
</LinearLayout>
