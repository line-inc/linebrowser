{
    "manifest_version": 2,
    "name": "Line Force Dark Theme",
    "version": "2.0.0",
    "description": "Premium, intelligent dark theme engine with dynamic contrast inversion, OLED black tuning, and media protection.",
    "browser_specific_settings": {
        "gecko": {
            "id": "line-force-dark@linebrowser.app"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "css": ["override.css"],
            "js": ["override.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}
