{
  "manifest_version": 2,
  "name": "Line Proxy Router",
  "version": "1.0.0",
  "description": "Routes browser traffic through the active Tor / SOCKS proxy via the WebExtension proxy API.",
  "browser_specific_settings": {
    "gecko": {
      "id": "line-proxy-router@linebrowser.app"
    }
  },
  "permissions": [
    "proxy",
    "nativeMessaging",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
